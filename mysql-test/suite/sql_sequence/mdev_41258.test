--source include/have_sequence.inc
--source include/have_debug.inc

--echo #
--echo # MDEV-41258 Server crashes in Item_func_nextval::val_int()/update_table()
--echo # when a table using DEFAULT NEXTVAL(sequence) is closed and reopened
--echo # between two executions of a prepared statement
--echo #

CREATE SEQUENCE s1 START WITH 1 INCREMENT BY 1 CACHE 10;
CREATE TABLE t1 (
  id  BIGINT NOT NULL DEFAULT NEXTVAL(s1),
  val VARCHAR(20),
  PRIMARY KEY(id)
);

PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 'row1';
EXECUTE stmt USING @v;

FLUSH TABLE t1;

--echo # The reopened table's sequence dependency must be relinked onto the
--echo # existing prelocking entry, not a new one.
SET @saved_dbug = @@SESSION.debug_dbug;
SET SESSION debug_dbug= '+d,assert_no_alloc_internal_tables';
SET @v = 'row2';
EXECUTE stmt USING @v;
SET SESSION debug_dbug= @saved_dbug;

SELECT val FROM t1 ORDER BY id;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;

--echo #
--echo # Same as above, but the second execution reaches the sequence
--echo # dependency through "USING DEFAULT" rather than a literal value.
--echo #

CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
INSERT INTO t1 (val) VALUES (1);

PREPARE stmt FROM 'UPDATE t1 SET id=?';
EXECUTE stmt USING DEFAULT;

FLUSH TABLE t1;

EXECUTE stmt USING 5;
SELECT * FROM t1;

DEALLOCATE PREPARE stmt;
DROP TABLE t1;
DROP SEQUENCE s1;

--echo #
--echo # Two different tables depending on the same sequence, linked by a
--echo # trigger, must each keep their own independent dependency: matching
--echo # must not let one table's entry be claimed by another's.
--echo #

CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TABLE t2 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);

DELIMITER $$;
CREATE TRIGGER tr AFTER INSERT ON t1 FOR EACH ROW
BEGIN
  INSERT INTO t2 (val) VALUES (100);
END $$
DELIMITER ;$$

PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 1;
EXECUTE stmt USING @v;

FLUSH TABLE t1;

SET @v = 2;
EXECUTE stmt USING @v;

SELECT * FROM t1;
SELECT * FROM t2;

DEALLOCATE PREPARE stmt;
DROP TRIGGER tr;
DROP TABLE t1, t2;
DROP SEQUENCE s1;

--echo #
--echo # A self-join referencing the same sequence-defaulted table twice in
--echo # one statement must also keep each reference independent.
--echo #

CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
INSERT INTO t1 (val) VALUES (1), (2);
UPDATE t1 a, t1 b SET a.val = DEFAULT WHERE a.id = b.id;
SELECT * FROM t1 ORDER BY id;
DROP TABLE t1;
DROP SEQUENCE s1;

--echo #
--echo # A dependency table dropped between two executions must not leave a
--echo # dangling write into freed memory when its own open is later skipped.
--echo #

CREATE SEQUENCE s1;
CREATE TABLE t1 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);
CREATE TABLE t2 (id INT NOT NULL DEFAULT NEXTVAL(s1), val INT);

DELIMITER $$;
CREATE TRIGGER tr AFTER INSERT ON t1 FOR EACH ROW
BEGIN
  IF NEW.val > 100 THEN
    INSERT INTO t2 (val) VALUES (NEW.val);
  END IF;
END $$
DELIMITER ;$$

PREPARE stmt FROM 'INSERT INTO t1 (val) VALUES (?)';
SET @v = 1;
EXECUTE stmt USING @v;

DROP TABLE t2;

SET @v = 2;
EXECUTE stmt USING @v;
SELECT * FROM t1;

DEALLOCATE PREPARE stmt;
DROP TRIGGER tr;
DROP TABLE t1;
DROP SEQUENCE s1;

--echo #
--echo # A DEFAULT reference inside a trigger's own sub-statement must not be
--echo # affected by relink processing meant for the top-level statement.
--echo #

CREATE SEQUENCE s2;
CREATE TABLE t3 (id INT NOT NULL DEFAULT NEXTVAL(s2), val INT);
CREATE TABLE t4 (id INT NOT NULL DEFAULT NEXTVAL(s2), val INT);
INSERT INTO t4 (val) VALUES (1);

DELIMITER $$;
CREATE TRIGGER tr2 AFTER INSERT ON t3 FOR EACH ROW
BEGIN
  UPDATE t4 SET id = DEFAULT, val = val + 10;
END $$
DELIMITER ;$$

INSERT INTO t3 (val) VALUES (1);
SELECT * FROM t4;

DROP TRIGGER tr2;
DROP TABLE t3, t4;
DROP SEQUENCE s2;

--echo # End of 11.4 tests
